# SheStays Community — Local Development Environment
# Copy to .env and fill in values
# NEVER commit .env to version control!
# This file contains LOCAL-ONLY defaults for Docker Compose development

# ============================================
# LOCAL POSTGRESQL CONFIGURATION
# ============================================
# These credentials are used ONLY by the local Docker Compose database service
# They are NEVER used in production and NEVER leave your machine
DB_USER=app_local
DB_PASSWORD=local_dev_password_change_me
DB_NAME=shestays_local
DB_HOST=database
DB_PORT=5432

# ============================================
# FRONTEND API CONFIGURATION
# ============================================
# Browser requests use the website origin; Next.js proxies them to the backend
# over the internal Docker network.
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_INTERNAL_URL=http://backend:8000

# ============================================
# SUPABASE CONFIGURATION (Local Development)
# ============================================
# For local development, you have two options:
# 1. Use a local Supabase instance (supabase start) - update these URLs accordingly
# 2. Use a dedicated Supabase project for development - fill in your dev project credentials
# 3. Mock mode: set NEXT_PUBLIC_USE_LIVE_API=false to use mock data

NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-supabase-anon-key

# Backend Supabase credentials (service role key for admin operations)
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=your-local-supabase-service-role-key
SUPABASE_ANON_KEY=your-local-supabase-anon-key

# ============================================
# APPLICATION CONFIGURATION
# ============================================
APP_ENV=development
LOG_LEVEL=DEBUG
CORS_ORIGINS=http://localhost:3000

# Rate Limiting (relaxed for local development)
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60

# ============================================
# ONESIGNAL (Push Notifications) - Optional for local dev
# ============================================
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# ============================================
# SENTRY (Error Tracking) - Optional for local dev
# ============================================
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ============================================
# FEATURE FLAGS
# ============================================
# Set to false to use mock data instead of live API calls
NEXT_PUBLIC_USE_LIVE_API=true

# ============================================
# ANALYTICS (Optional)
# ============================================
NEXT_PUBLIC_GA_ID=

# ============================================
# DOCUMENTATION: API URL BEHAVIOR
# ============================================
# Browser-side requests (client components, user interactions):
#   - Use the same-origin path /api/v1
#   - Next.js forwards requests to API_INTERNAL_URL inside Docker
#
# Server-side requests (SSR, API routes in Next.js):
#   - Uses internal Docker DNS: http://backend:8000/api/v1
#   - The API proxy target is configured with API_INTERNAL_URL
#
# Backend internal database connection:
#   - Uses DATABASE_URL = postgresql://app_local:xxx@database:5432/shestays_local
#   - 'database' resolves to the PostgreSQL container via database_network
